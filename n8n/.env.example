# ========================================
# Vespuc.io - Configuração n8n
# ========================================

# ===================
# SUPABASE
# ===================
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===================
# GEMINI AI
# ===================
# Obtenha em: https://aistudio.google.com/apikey
# Free tier: 60 requests/min

GEMINI_API_KEY=AIzaSy...

# ===================
# N8N
# ===================
# URL base para webhooks (ajuste se em produção)
N8N_WEBHOOK_BASE_URL=http://localhost:5678

# Opcional: Para debug
# N8N_LOG_LEVEL=debug

# ===================
# TESTES (opcional)
# ===================
# Para rodar scripts de teste

# UUID do blog de teste (obtenha do Supabase)
BLOG_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# UUID do usuário (obtenha do Supabase auth.users)
USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ===================
# PRODUÇÃO (opcional)
# ===================
# Se for fazer deploy em produção

# Database (se usar PostgreSQL separado)
# DB_POSTGRESDB_HOST=localhost
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=password

# Webhook URL em produção
# N8N_WEBHOOK_BASE_URL=https://n8n.yourdomain.com

# Credenciais básicas (opcional)
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=password

# Timezone
# GENERIC_TIMEZONE=America/Sao_Paulo
# TZ=America/Sao_Paulo

# ===================
# COMO USAR
# ===================
#
# 1. Copie este arquivo:
#    cp .env.example .env
#
# 2. Preencha os valores reais
#
# 3. Carregue as variáveis:
#    source .env
#
# 4. Suba o n8n:
#    docker run -d --env-file .env -p 5678:5678 n8nio/n8n
#
# ===================
