      "id": "check-new-posts",
      "name": "Check New Posts",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2660, 300]
    },
    {
      "parameters": {
        "functionCode": "const blog_id = $json.blog_id;\nconst user_id = $json.user_id;\nconst new_urls = $json.new_urls;\n\n// Cria array de posts para inserir\nconst posts = new_urls.map(url => ({\n  blog_id,\n  user_id,\n  url,\n  status: 'pending',\n  created_at: new Date().toISOString()\n}));\n\nreturn { posts };"
      },
