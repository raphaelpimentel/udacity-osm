    {
      "parameters": {
        "functionCode": "const blog = $input.item.json[0];\nconst base_url = blog.base_url.replace(/\\/$/, '');\n\nreturn {\n  blog_id: blog.id,\n  user_id: blog.user_id,\n  base_url: base_url,\n  sitemap_urls: [\n    `${base_url}/sitemap_index.xml`,\n    `${base_url}/sitemap.xml`,\n    `${base_url}/robots.txt`\n  ]\n};"
      },
