      "id": "merge-sitemap-results",
      "name": "Merge Sitemap Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [1780, 300]
    },
    {
      "parameters": {
        "functionCode": "const items = $input.all();\nconst cheerio = require('cheerio');\n\nconst blog_id = items[0].json.blog_id;\nconst user_id = items[0].json.user_id;\nconst base_url = items[0].json.base_url;\n\nlet allUrls = [];\n\n// Tenta parsear cada resposta\nfor (const item of items) {\n  try {\n    const data = item.json.data;\n    if (!data) continue;\n    \n    // Se for sitemap XML\n    if (data.includes('<?xml') && data.includes('<urlset')) {\n      const $ = cheerio.load(data, { xmlMode: true });\n      $('url > loc').each((i, elem) => {\n        allUrls.push($(elem).text());\n      });\n    }\n    \n    // Se for sitemap index\n    if (data.includes('<?xml') && data.includes('<sitemapindex')) {\n      const $ = cheerio.load(data, { xmlMode: true });\n      $('sitemap > loc').each((i, elem) => {\n        allUrls.push($(elem).text());\n      });\n    }\n    \n    // Se for robots.txt\n    if (data.includes('Sitemap:')) {\n      const lines = data.split('\\n');\n      for (const line of lines) {\n        if (line.toLowerCase().startsWith('sitemap:')) {\n          const url = line.split(':', 2)[1].trim();\n          allUrls.push(url);\n        }\n      }\n    }\n  } catch (e) {\n    console.log('Erro ao parsear:', e.message);\n  }\n}\n\n// Remove duplicatas\nallUrls = [...new Set(allUrls)];\n\n// Filtra apenas posts (heurística: URLs com path maior que /)\nconst postUrls = allUrls.filter(url => {\n  try {\n    const path = new URL(url).pathname;\n    return path.split('/').filter(p => p).length > 0;\n  } catch {\n    return false;\n  }\n});\n\nreturn {\n  blog_id,\n  user_id,\n  base_url,\n  discovered_urls: postUrls,\n  total_found: postUrls.length\n};"
      },
