    {
      "parameters": {
        "functionCode": "const discovered = $input.first().json.discovered_urls || [];\nconst existing = $input.last().json.map(p => p.url);\n\n// Diff: URLs novas\nconst newUrls = discovered.filter(url => !existing.includes(url));\n\nconst blog_id = $input.first().json.blog_id;\nconst user_id = $input.first().json.user_id;\n\nreturn {\n  blog_id,\n  user_id,\n  new_urls: newUrls,\n  total_new: newUrls.length\n};"
      },
